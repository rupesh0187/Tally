@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert error" role="alert">@Error</div>
}
@if (!string.IsNullOrEmpty(Notice))
{
    <div class="alert ok" role="status">@Notice</div>
}

@code {
    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public string? Notice { get; set; }
}
