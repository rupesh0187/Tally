  <PropertyGroup>
    <TargetFramework>$(TallyNextTargetFramework)</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TallyNext.Application\TallyNext.Application.csproj" />
  </ItemGroup>
</Project>
