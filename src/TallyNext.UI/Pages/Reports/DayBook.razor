@page "/reports/day-book"
@inherits AppPage

<PageTitle>Day Book — TallyNext</PageTitle>

<div class="page-head">
    <div><h1>Day Book</h1><div class="muted">@Fmt.Date(_from) to @Fmt.Date(_to)</div></div>
    <PeriodBar From="_from" To="_to" Year="State.CurrentYear" OnChange="ApplyAsync" />
</div>
<label class="small"><input type="checkbox" @bind="_includeDrafts" @bind:after="LoadAsync" /> Include drafts</label>
<Alerts Error="@Error" />

@if (_report is { } r)
{
    <table class="data" style="margin-top:.5rem">
        <thead><tr><th>Date</th><th>Particulars</th><th>Type</th><th>No.</th><th class="num">Debit</th><th class="num">Credit</th></tr></thead>
        <tbody>
            @foreach (var row in r.Rows.Items)
            {
                <tr class="clickable" @onclick='() => Nav.NavigateTo($"vouchers/{row.VoucherId}")'>
                    <td>@Fmt.Date(row.Date)</td>
                    <td>@row.Particulars @if (!string.IsNullOrEmpty(row.Narration)) { <div class="muted small">@row.Narration</div> }</td>
                    <td>@row.VoucherTypeName @if (row.Status == VoucherStatus.Draft) { <span class="tag draft">draft</span> } @if (row.IsReversal) { <span class="tag">reversal</span> }</td>
                    <td>@(row.Number ?? "—")</td>
                    <td class="num">@Fmt.Amount(row.Debit)</td>
                    <td class="num">@Fmt.Amount(row.Credit)</td>
                </tr>
            }
            @if (r.Rows.TotalCount == 0)
            {
                <tr><td colspan="6" class="muted">No vouchers in this period.</td></tr>
            }
        </tbody>
        <tfoot><tr class="total"><td colspan="4">Total of posted vouchers in the period</td><td class="num" colspan="2">@Fmt.AmountOrZero(r.PeriodTotal)</td></tr></tfoot>
    </table>
    <Pager Page="r.Rows.Page" TotalPages="r.Rows.TotalPages" TotalCount="r.Rows.TotalCount" PageChanged="GoAsync" />
}

@code {
    private DateOnly _from;
    private DateOnly _to;
    private int _page = 1;
    private bool _includeDrafts;
    private DayBookReport? _report;

    protected override async Task OnInitializedAsync()
    {
        if (!State.HasCompany)
        {
            return;
        }

        _to = State.Today;
        _from = new DateOnly(_to.Year, _to.Month, 1) < State.PeriodStart ? State.PeriodStart : new DateOnly(_to.Year, _to.Month, 1);
        if (_to < _from)
        {
            _to = _from;
        }

        await LoadAsync();
    }

    private Task ApplyAsync((DateOnly From, DateOnly To) range)
    {
        (_from, _to, _page) = (range.From, range.To, 1);
        return LoadAsync();
    }

    private Task GoAsync(int page)
    {
        _page = page;
        return LoadAsync();
    }

    private Task LoadAsync() => RunAsync(async () =>
        _report = await Runner.RunAsync<ReportService, DayBookReport>(s => s.DayBookAsync(State.CompanyId, _from, _to, _page, 100, _includeDrafts)));
}
