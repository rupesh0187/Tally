{
  "ConnectionStrings": {
    "Server": ""
  },
  "Database": {
    "Provider": "Postgres",
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "tallynext",
    "Audience": "tallynext-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Auth": {
    "AllowSelfRegistration": false,
    "OfflineGraceDays": 7
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 20
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
