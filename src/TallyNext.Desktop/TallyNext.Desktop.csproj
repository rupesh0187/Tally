<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!--
    .NET MAUI Blazor Hybrid shell for Windows. Requires the MAUI Windows workload:
      dotnet workload install maui-windows      (elevated)
    All behaviour lives in TallyNext.Desktop.Core / TallyNext.UI / TallyNext.Infrastructure.Local,
    which build and are tested without the workload.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>TallyNext.Desktop</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>TallyNext</ApplicationTitle>
    <ApplicationId>com.tallynext.desktop</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Unpackaged desktop app (no MSIX) for the first releases. -->
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

    <!-- Platform tooling emits advisory warnings outside our control. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#0F6E7A" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#13232F" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TallyNext.Desktop.Core\TallyNext.Desktop.Core.csproj" />
  </ItemGroup>
</Project>
