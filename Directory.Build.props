<Project>
  <!--
    Shared build settings for every project in the repository.
    Individual projects may override these (the MAUI desktop head relaxes
    TreatWarningsAsErrors because platform tooling emits advisory warnings).
  -->
  <PropertyGroup>
    <TallyNextTargetFramework>net10.0</TallyNextTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Company>TallyNext</Company>
    <Product>TallyNext</Product>
    <Copyright>Copyright (c) TallyNext contributors</Copyright>
    <!-- NU1903/NU1904: known-vulnerability warnings stay visible but must not break local builds silently -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
